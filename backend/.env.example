# Copy this file to .env and replace placeholders. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Must match infra/docker-compose.yml local-only PostgreSQL credentials.
DATABASE_URL=postgresql://aquarium_app:local_dev_change_me_only@127.0.0.1:5432/smart_aquarium_dev

# Local broker is bound to localhost only. Use mqtts:// + TLS options in production.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=aquarium_backend
MQTT_PASSWORD=REPLACE_WITH_PASSWORD_CREATED_BY_SETUP_SCRIPT

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_BEARER_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTER_TOKEN
